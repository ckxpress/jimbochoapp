<?xml version="1.0" encoding="UTF-8"?>
<!--
  One entry, honestly.

  The catalogue holds 448,000 books across 761 browsable scopes, and not one
  of them has an address a search engine can index: the app routes on the URL
  hash, and a fragment is not a separate URL. Listing invented paths here
  would have Search Console report them as errors, so this lists what exists.

  No <lastmod>: the catalogue is rebuilt weekly but this page's address never
  changes, and a timestamp that moves without the content moving teaches a
  crawler to stop trusting it. When real paths arrive, this file should be
  generated by the build with a lastmod per scope that means something.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://jimbocho.app/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
