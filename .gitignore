node_modules/
.DS_Store

# Downloaded source files are disposable, but the cover lookups are 15,996
# requests to someone else's service — keep those so rebuilds don't repeat them.
cache/*
!cache/covers.json

# Generated by `npm run build:db` from the shards, so it is rebuildable and
# does not belong in history: ~45 MB per rebuild, kept forever by git.
site/data/books.db

# wrangler keeps a local simulation of R2 here — 57 MB of books.db copy
.wrangler/

# The database under its content-hashed object name, linked here only to
# upload it to R2 by hand — the dashboard takes the object key from the
# filename, and the hash in that name is what keeps a stale edge-cache entry
# from shadowing a rebuild.
books-*.db

# The D1 import, regenerated by `node tools/build-d1.js`: 298 MB of SQL across
# 224 chunk files, derived entirely from site/data/books.db. Keeping it would
# put a third copy of the catalogue in history, and .applied inside it is a
# record of one machine's import progress, meaningless anywhere else.
build/
